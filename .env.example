# Copy to .env for local dev (.env is gitignored). Every process.env.* the code
# reads appears here.

# Perimeter bearer token for /mcp. When set, every /mcp call must send
#   Authorization: Bearer <this value>
# Leave UNSET locally to run open (the server warns). On a hosted runtime
# (RENDER set) an unset token makes the server refuse to boot (exit 1).
# Use real entropy in production, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# HTTP port. Defaults to 3000. On Render this is injected by the platform.
PORT=3000

# Log verbosity: error | warn | info | debug (default info), or silent to mute.
LOG_LEVEL=info

# NOTE: RENDER is NOT set here. The Render platform sets it automatically; the
# app keys its fail-closed boot posture on it. Do not set it locally.
